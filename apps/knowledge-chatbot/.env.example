# Configure at least one chat provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Keep one embedding provider fixed for the entire knowledge base.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
OPENROUTER_EMBEDDING_MODEL=
NVIDIA_EMBEDDING_MODEL=

# Optional Upstash/Vercel KV REST persistence.
KV_REST_API_URL=
KV_REST_API_TOKEN=
ADMIN_TOKEN=
PREFER_FREE=true
DEFAULT_PROVIDER=auto
ASSISTANT_PERSONA=You are a helpful knowledge-base assistant.
