# Copy this file to `.env` and fill in your keys:
#   cp .env.example .env

# Host port the dashboard is published on
SAI_PORT=3000

# Active provider (openrouter | openai | anthropic | google | ollama | ...)
SAI_PRIMARY_PROVIDER=openrouter

# --- AI provider API keys (leave blank to skip) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
GROK_API_KEY=
KIMI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PI_API_KEY=

# --- Bhashini multilingual AI ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=s-ai-user
BHASHINI_PIPELINE_ID=

# --- Local providers ---
# Points at Ollama (or another local LLM server) running on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
